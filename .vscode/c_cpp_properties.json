{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include",                // 系统头文件根目录（必加）
                "/usr/include/libcamera",      // libcamera 头文件目录
                "/usr/include/opencv4",        // OpenCV 头文件目录
                "/usr/local/include"           // 本地头文件目录
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",    // 树莓派默认 g++ 路径
            "cStandard": "c17",               // libcamera 要求 C++17
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm64",  // 适配树莓派 ARM64
            "browse": {
                "path": [
                    "/usr/include",
                    "/usr/lib/aarch64-linux-gnu",  // libcamera.so 所在路径
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": false,  // 关键：加载所有符号
                "databaseFilename": ""
            },
            "configurationProvider": "ms-vscode.cmake-tools"  // 兼容 CMake
        }
    ],
    "version": 4
}